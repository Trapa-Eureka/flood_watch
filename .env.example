# Copy this file to .env and fill in the real values. .env is in .gitignore and won't be committed.
# Never hardcode real values in this example file or in code.

# Copernicus Data Space Ecosystem account (free signup: https://dataspace.copernicus.eu)
# Needed to download Sentinel-1/2 STAC assets.
CDSE_USERNAME=
CDSE_PASSWORD=

# HuggingFace token (only needed if the Prithvi checkpoint is a gated model)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Supabase (PostGIS DB — spec.md §6/§5). Project created via `supabase projects create`,
# schema applied via `supabase db push` (see supabase/migrations/). service_role bypasses
# RLS — only the pipeline backend should hold it, never ship it to the frontend.
# (URL/project ref aren't secrets — they live in pipeline/config.py, not here.)
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (raw scene + tile storage — spec.md §5, buckets: pipeline/config.py).
# The account ID isn't secret (it's already in pipeline/config.py). The access
# key/secret ARE secret and can only be minted from the Cloudflare dashboard —
# no CLI command creates them: dashboard -> R2 -> "Manage API Tokens" -> Create
# API Token -> scope it to ph-flood-watch-raw + ph-flood-watch-tiles, Object
# Read & Write, then paste the two values it shows you (only shown once).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

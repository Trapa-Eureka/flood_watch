# 이 파일을 .env로 복사하고 실제 값을 채운다. .env는 .gitignore에 있어 커밋되지 않는다.
# 절대 실제 값을 이 예시 파일이나 코드에 하드코딩하지 말 것.

# Copernicus Data Space Ecosystem 계정 (무료 가입: https://dataspace.copernicus.eu)
# Sentinel-1/2 STAC 자산 다운로드에 필요.
CDSE_USERNAME=
CDSE_PASSWORD=

# HuggingFace 토큰 (Prithvi 체크포인트가 gated 모델일 경우에만 필요)
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=
